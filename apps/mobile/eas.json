{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "parent" }
    },
    "preview-child": {
      "extends": "preview",
      "env": { "APP_VARIANT": "child" }
    }
  }
}
