{
  "name": "@parent-pal/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Một dự án Expo, hai biến thể APP_VARIANT=parent|child (T0.8). Cùng Expo SDK 58 với mobile/ cũ.",
  "scripts": {
    "start": "expo start --dev-client",
    "start:parent": "APP_VARIANT=parent expo start --dev-client",
    "start:child": "APP_VARIANT=child expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "config:parent": "APP_VARIANT=parent expo config --json",
    "config:child": "APP_VARIANT=child expo config --json",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-battery": "~58.0.3",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
