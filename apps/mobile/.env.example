# Sao thành .env (đã bị .gitignore). KHÔNG commit .env, KHÔNG ghi giá trị thật vào file này.
# Địa chỉ dự án Supabase và khóa công khai (publishable). Không dùng khóa service_role ở app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Đặt 1 để chạy giao diện với dữ liệu giả lập, không cần backend (bỏ qua hai biến trên).
EXPO_PUBLIC_API_MOCK=
