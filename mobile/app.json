{
  "expo": {
    "name": "Parent-Pal Lab",
    "slug": "parent-pal",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parentpal",
    "userInterfaceStyle": "light",
    "android": {
      "package": "vn.parentpal.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "lab"
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Parent-Pal dùng vị trí để báo khi con vào hoặc ra khỏi Nhà, Trường, nơi học thêm. App chỉ ghi sự kiện vào/ra, không theo dõi liên tục."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Parent-Pal cần micro để ghi âm bài đọc, bài nói của con."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Parent-Pal cần camera để chụp bài làm của con."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
